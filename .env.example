# =============================================================================
# Global Softel RAG Chat - environment configuration
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.
#   PowerShell:  Copy-Item .env.example .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Comma separated list of allowed browser origins for the API (CORS).
# Vite dev server default is http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# OPTION A (recommended for production): a real PostgreSQL server with pgvector.
#   DATABASE_URL=postgres://rag_user:change_me@localhost:5432/rag_chat
# Leave it EMPTY to use the bundled zero-install embedded PostgreSQL (PGlite)
# with the real pgvector extension. See README for details.
DATABASE_URL=
# Directory used for the embedded database when DATABASE_URL is empty.
PGLITE_DIR=./storage/pgdata

# --- Secrets -----------------------------------------------------------------
# 32+ character master key used to encrypt provider API keys at rest (AES-256-GCM).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# --- Storage -----------------------------------------------------------------
# Where original uploaded files and derived artefacts are kept (local filesystem).
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# --- Chunking / ingestion ----------------------------------------------------
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
INGESTION_CONCURRENCY=1
INGESTION_MAX_ATTEMPTS=3

# --- Embeddings (local by default; no cloud call required) -------------------
# provider: local | ollama | openai | hash (hash = offline/dev only, not semantic)
DEFAULT_EMBEDDING_PROVIDER=local
DEFAULT_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Vector dimension stored in the database. MUST match DEFAULT_EMBEDDING_MODEL.
#   Xenova/all-MiniLM-L6-v2      -> 384
#   Xenova/bge-small-en-v1.5     -> 384
#   Xenova/all-mpnet-base-v2     -> 768
#   ollama:nomic-embed-text      -> 768
#   openai:text-embedding-3-small-> 1536
EMBEDDING_DIM=384
# Local model cache directory (transformers.js / Hugging Face).
HF_HOME=./storage/models

# --- LLM (hosted) ------------------------------------------------------------
# Only two providers can answer questions: OpenRouter and Groq.
# These are only DEFAULTS; real provider keys are configured in the UI and stored
# encrypted in the database. Never put real keys in this file.
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# When true the backend refuses to call any hosted LLM (privacy mode).
DISABLE_HOSTED_AI=false

# --- OpenRouter (default) ---------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used when no provider configuration is stored in the database.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-chat-v3-0324

# --- Groq (fallback) --------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b

# --- Retrieval tuning --------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_CANDIDATES=30
RETRIEVAL_KEYWORD_CANDIDATES=30
RETRIEVAL_MIN_SCORE=0.0
# Drop vector-only matches scoring below this fraction of the best match
# (0.35 = keep anything at least 35% as similar as the top hit; 0 disables).
RETRIEVAL_RELATIVE_CUTOFF=0.35
RETRIEVAL_MAX_CONTEXT_CHARS=16000
RETRIEVAL_RERANK_ENABLED=false

# --- Request timeouts (ms) ---------------------------------------------------
LLM_REQUEST_TIMEOUT_MS=120000
# Maximum silence before a streaming answer is aborted.
LLM_STREAM_IDLE_TIMEOUT_MS=60000
EMBEDDING_REQUEST_TIMEOUT_MS=60000

# --- Deadlines for the ask flow and the ingestion pipeline (ms) -------------
# Every stage of a question has a budget, so the UI can never hang.
ASK_TIMEOUT_MS=180000
RETRIEVAL_TIMEOUT_MS=60000
DB_QUERY_TIMEOUT_MS=30000
INGESTION_PARSE_TIMEOUT_MS=180000
INGESTION_JOB_TIMEOUT_MS=900000
# A "processing" job older than this is treated as orphaned and re-queued.
INGESTION_STALE_JOB_MS=1200000

# --- Web crawling (web links, link lists, re-crawls) ------------------------
# The crawler is SSRF-safe by default: only http/https, no credentials, and
# loopback/link-local/private hosts are refused (each redirect hop is checked).
# Set CRAWL_ALLOW_PRIVATE_HOSTS=true only on a trusted machine.
CRAWL_TIMEOUT_MS=30000
# Hard cap on one downloaded page.
CRAWL_MAX_BYTES=5242880
CRAWL_MAX_REDIRECTS=5
CRAWL_MAX_ATTEMPTS=3
CRAWL_CONCURRENCY=1
CRAWL_USER_AGENT=GlobalSoftelRagBot/1.0 (local knowledge-base crawler)
CRAWL_ALLOW_PRIVATE_HOSTS=false
# A "processing" crawl job older than this is treated as orphaned and re-queued.
CRAWL_STALE_JOB_MS=300000
